<Window x:Class="WarehouseManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WarehouseManager.App.ViewModels"
        Title="Управление складом — Организации" Height="520" Width="720"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Организации" FontSize="16" Margin="2"/>
        <ListBox Grid.Row="1" Grid.Column="0"
                 ItemsSource="{Binding Organizations}"
                 SelectedItem="{Binding SelectedOrganization}"
                 DisplayMemberPath="Name"
                 MouseDoubleClick="OnItemDoubleClick">
            <ListBox.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Новая организация"   Command="{Binding AddCommand}"/>
                    <MenuItem Header="Изменить организацию" Command="{Binding EditCommand}"/>
                    <MenuItem Header="Удалить организацию"  Command="{Binding DeleteCommand}"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
            <Button Content="ОК"       Command="{Binding OpenCommand}" Height="32"/>
            <Button Content="Закрыть"  Click="OnClose"                 Height="32"/>
        </StackPanel>

        <StatusBar Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding SelectedOrganization.Name, StringFormat='Выбрано: {0}'}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>