<Window x:Class="WarehouseManager.App.Views.InvoiceItemDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор товара" Height="420" Width="640"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Выберите товар:" Margin="3"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул"     Binding="{Binding Article}" Width="110"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}"    Width="*"/>
                <DataGridTextColumn Header="Остаток"     Binding="{Binding Stock}"   Width="80"/>
                <DataGridTextColumn Header="Цена"        Binding="{Binding Price, StringFormat={}{0:C}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Количество:" VerticalAlignment="Center" Margin="3"/>
            <TextBox Width="80" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="ОК"     Width="90" Click="OnOk"/>
            <Button Content="Отмена" Width="90" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>