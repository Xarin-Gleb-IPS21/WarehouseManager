<Window x:Class="WarehouseManager.App.Views.InvoicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список накладных" Height="480" Width="820"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Накладные" FontSize="16" Margin="2"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Invoices}"
                  SelectedItem="{Binding SelectedInvoice}"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№"          Binding="{Binding Number}"   Width="100"/>
                <DataGridTextColumn Header="Дата"       Binding="{Binding Date, StringFormat=d}" Width="120"/>
                <DataGridTextColumn Header="Тип"        Binding="{Binding Type}"     Width="120"/>
                <DataGridTextColumn Header="Статус"     Binding="{Binding Status}"   Width="120"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="Создать" Width="110" Command="{Binding CreateCommand}"/>
            <Button Content="Просмотр" Width="110" Command="{Binding ViewCommand}"/>
            <Button Content="Изменить" Width="110" Command="{Binding EditCommand}"/>
            <Button Content="Провести" Width="110" Command="{Binding PostCommand}"/>
            <Button Content="Отменить" Width="110" Command="{Binding UnpostCommand}"/>
            <Button Content="Удалить" Width="110" Command="{Binding DeleteCommand}"/>
        </StackPanel>

        <StatusBar Grid.Row="3" Background="{StaticResource PanelBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding ContextInfo}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>